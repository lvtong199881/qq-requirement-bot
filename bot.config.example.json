{
  "repos": [
    {
      "id": "app",
      "name": "示例项目",
      "path": "~/Documents/ChatGPT/Instanto",
      "platform": "harmony"
    }
  ],
  "dshBin": "dsh",
  "profile": "qqbot",
  "bot": {
    "name": "产品同学"
  },
  "approval": "manual",
  "limits": {
    "maxConcurrentTurns": 2,
    "maxWorktrees": 12
  },
  "heartbeat": {
    "enabled": true,
    "idleMinutes": 5
  },
  "upload": {
    "enabled": true,
    "maxFiles": 8,
    "maxFileMB": 20
  },
  "turnTimeoutMs": 2700000,
  "verbose": false,
  "envHints": "",
  "panel": {
    "enabled": true,
    "port": 7878,
    "publicPort": 7879,
    "token": ""
  },
  "api": {
    "enabled": true,
    "port": 7881,
    "host": "0.0.0.0",
    "allowedOrigin": "",
    "maxBodyBytes": 1000000
  }
}
