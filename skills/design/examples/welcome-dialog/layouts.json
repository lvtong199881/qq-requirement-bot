  "copy": {
    "zh": {
      "title": "欢迎使用 DoDroidAI",
      "intro": "说一句话，让手机替你做事。",
      "features": [
        {
          "icon": "mic",
          "title": "按住说话就行",
          "desc": "语音识别和朗读在手机本地完成；首次使用需联网下载语音模型（默认 Wi-Fi 下自动下载）。"
        },
        {
          "icon": "phone",
          "title": "它会动手，不只是聊天",
          "desc": "发短信、记笔记前会先请你确认；闹钟、日历等操作直接执行。"
        },
        {
          "icon": "lock",
          "title": "会话和笔记留在本机",
          "desc": "保存在本机，会话可随时导出；使用 AI 时内容会发送给你配置的服务商。"
        }
      ],
      "button": "开始使用"
    },
    "en": {
      "title": "Welcome to DoDroidAI",
      "intro": "Say it, and let your phone do it.",
      "features": [
        {
          "icon": "mic",
          "title": "Just hold to talk",
          "desc": "Speech recognition and read-aloud run on your phone; voice models download once over the network (automatic on Wi-Fi)."
        },
        {
          "icon": "phone",
          "title": "It acts, not just chats",
          "desc": "Sending texts and saving notes ask for your confirmation first; alarms and calendar events run directly."
        },
        {
          "icon": "lock",
          "title": "Chats and notes stay on this phone",
          "desc": "Stored locally; chats can be exported anytime. AI requests go to the provider you configure."
        }
      ],
      "button": "Get started"
    }
  },
